# Base URL of the AegisLLM FastAPI backend (no trailing slash)
VITE_API_BASE_URL=http://localhost:8000

# OAuth (backend supports google + github via authorization-code flow:
# POST /auth/oauth { provider, code }). These client IDs and the redirect
# URI must be registered with each provider and must match what the
# backend expects to exchange the code with.
VITE_GOOGLE_CLIENT_ID=
VITE_GITHUB_CLIENT_ID=
# Should point at /oauth/callback on wherever this app is hosted, e.g.
# http://localhost:5173/oauth/callback
VITE_OAUTH_REDIRECT_URI=http://localhost:5173/oauth/callback
